# Lead Generation Agent - Environment Configuration
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------
# Next.js / Application
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Supabase (Postgres persistence + Auth)
# Required: Supabase project URL and anon/public key
# Obtain from your Supabase project dashboard (Settings > API)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Model provider (LLM for outreach generation, research, classification)
# Required: API key for your chosen model provider (e.g., OpenAI, Anthropic)
# ---------------------------------------------------------------
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_DEFAULT=gpt-4o-mini

# ---------------------------------------------------------------
# Email provider (outbound outreach)
# Required: SMTP credentials or email-sending service API key
# ---------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# or for API-based providers (SendGrid, Resend, etc.)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ---------------------------------------------------------------
# Calendar / scheduling provider (meeting management)
# ---------------------------------------------------------------
CALENDAR_PROVIDER=google
CALENDAR_API_KEY=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=

# ---------------------------------------------------------------
# Prospect discovery / data enrichment provider
# ---------------------------------------------------------------
DISCOVERY_PROVIDER=
DISCOVERY_API_KEY=

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ---------------------------------------------------------------
# Operational controls
# ---------------------------------------------------------------
DAILY_SEND_LIMIT_PER_WORKSPACE=50
MAX_REVENUE_COST_CEILING_USD=500
EMERGENCY_PAUSE=false
